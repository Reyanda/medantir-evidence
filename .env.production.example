# Copy to .env.production and set every required value before starting.
CORS_ORIGINS=https://your-evidence-app.example.org
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=example-client-id

# Optional but strongly recommended for NCBI production use.
NCBI_EUTILS_EMAIL=review-team@example.org
NCBI_API_KEY=

# Optional authenticated registry and identity integrations.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://your-api.example.org/review/auth/orcid/callback
ORCID_SANDBOX=0
ZENODO_ACCESS_TOKEN=
GITHUB_TOKEN=

# Optional inference gateway. Leave unset for deterministic/human-only gates.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://host.docker.internal:20128
OMNIROUTE_SHADOW_MODEL=
OMNIROUTE_ROB2_MODEL=

# Optional infrastructure overrides.
REVIEW_PORT=8788
REVIEW_MAX_SEARCH_RECORDS=10000
DOCUMENT_PARSE_MIN_QUALITY=0.55
LITEPARSE_TIMEOUT_MS=45000
PARSE_URL=https://api.actiora.com/parse
REVIEW_BRIDGE_URL=http://host.docker.internal:10086

# Prefer a secret manager in managed deployments. For Docker Compose, the first
# start may bootstrap a random key into the persistent /data volume. Supplying a
# 32-byte base64 or 64-character hexadecimal key disables bootstrap dependence.
REVIEW_CREDENTIAL_MASTER_KEY=
# Set to 0 and provide REVIEW_CREDENTIAL_MASTER_KEY in managed infrastructure.
REVIEW_ALLOW_BOOTSTRAP_KEY=1
